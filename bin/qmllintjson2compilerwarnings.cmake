if(NOT DEFINED JSON_FILE)
    message(FATAL_ERROR "❌ Missing argument 'JSON_FILE'!")
endif()

file(READ ${JSON_FILE} document)

string(JSON files GET "${document}" files)
string(JSON number_of_files LENGTH "${document}" files)
set(i 0)
WHILE(i LESS number_of_files)
    string(JSON file GET "${files}" ${i})
    math(EXPR i "${i} + 1")
    string(JSON filename GET "${file}" filename)
    string(JSON warnings GET "${file}" warnings)
    string(JSON number_of_warnings LENGTH "${file}" warnings)
    set(j 0)
    while(j LESS number_of_warnings)
        string(JSON warning GET "${warnings}" ${j})
        math(EXPR j "${j} + 1")
        string(JSON line ERROR_VARIABLE error GET "${warning}" line)
        if(error)
            set(line 0)
        endif()
        string(JSON column ERROR_VARIABLE error GET "${warning}" column)
        if(error)
            set(column 0)
        endif()
        string(JSON id GET "${warning}" id)
        string(JSON message GET "${warning}" message)
        message("${filename}:${line}:${column}: warning: ${message} [${id}]")
    endwhile()
endwhile()
