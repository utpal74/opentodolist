msgctxt "NewLibraryFromAccountPage|"
msgid "No libraries were found on the server."
msgstr "Inga bibliotek hittades på servern."

#: ../qml/Pages/NewLibraryFromAccountPage.qml:121
msgctxt "NewLibraryFromAccountPage|"
msgid "Searching existing libraries..."
msgstr "Söker befintliga bibliotek ..."

#: ../qml/Pages/NewLibraryFromAccountPage.qml:164
msgctxt "NewLibraryFromAccountPage|"
msgid "Create a New Library"
msgstr "Skapa ett nytt bibliotek"

#: ../qml/Pages/NewLibraryFromAccountPage.qml:172
msgctxt "NewLibraryFromAccountPage|"
msgid "Create a new library, which will be synchronized with the server. Such a library can be added to the app on other devices as well to synchronize data."
msgstr "Skapa ett nytt bibliotek som skall synkroniseras med servern. Ett sådant bibliotek kan läggas till i programmet på andra enheter också, för att synkronisera data."

